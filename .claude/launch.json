{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "exec", "next", "dev", "--port", "3000"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "storybook",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export PATH=\"$HOME/.nvm/versions/node/v22.18.0/bin:$PATH\" && exec pnpm --filter storybook exec storybook dev -p 6006 --ci"
      ],
      "port": 6006,
      "url": "http://localhost:6006"
    }
  ]
}
