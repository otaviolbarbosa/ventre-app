NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# STRPIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Resend
RESEND_API_KEY=re_xxxxxxxxx

# Google Calendar Integration
# Same values as the Google OAuth provider in Supabase Dashboard → Authentication → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# WhatsApp Integration
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_APP_SECRET
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

CRON_SECRET=

# Notification queue worker (/api/cron/process-notification-queues): "true" (default,
# safe) runs the full pipeline but skips the real Firebase push send; "false" sends
# real pushes. Keep "true" while the legacy scheduled_notifications pipeline is active.
NOTIFICATION_QUEUE_DRY_RUN=true

# Modo Parto — Fase 2 Realtime spike (temporary flag). "true" opens a Supabase Realtime
# WebSocket subscription for pregnancies.birth_mode_active changes. Keep "false"/unset in
# production until Fase 5 (redirect UI) ships and promotes this to a permanent feature.
NEXT_PUBLIC_BIRTH_MODE_REALTIME_SPIKE=false
