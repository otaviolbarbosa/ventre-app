{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://ventre-web-dev.vercel.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "585581972014-6fqvigc9sjtn4jq4tt6bl4nogttlr9rn.apps.googleusercontent.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://ventre-web-dev.vercel.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "585581972014-6fqvigc9sjtn4jq4tt6bl4nogttlr9rn.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://ventre.app",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "1074052440136-f09ajfdvb7gd4da81rqr9pveprrvqmhh.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services/play-store-service-account.json",
        "track": "internal"
      }
    }
  }
}
